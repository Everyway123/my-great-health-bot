# Telegram token НОВОГО health-бота (з BotFather). НІКОЛИ не комітити реальний.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Кому дозволено писати боту (Telegram user id, через кому)
ALLOWED_USER_IDS=123456789

# Anthropic API key (той самий, що в Hermes — можна скопіювати)
ANTHROPIC_API_KEY=sk-ant-replace-me

# Postgres — ТА САМА база, що в Hermes (jubilant-hope). Схема ведеться
# нумерованими міграціями (src/db/migrations.ts), які застосовуються при старті.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Часовий пояс для кронів і «сьогодні»
TIMEZONE=Europe/Lisbon

# --- Oura (необовʼязково, але це головне джерело даних) ---------------------
# Personal access tokens Oura скасувала в грудні 2025 — працює тільки OAuth2.
# Зареєструй застосунок: https://cloud.ouraring.com/oauth/applications
# Redirect URI може бути будь-яким зареєстрованим URL: бот не приймає редірект,
# ти копіюєш code з адресного рядка руками один раз (/oura → /oura_code).
OURA_CLIENT_ID=replace-me
OURA_CLIENT_SECRET=replace-me
OURA_REDIRECT_URI=https://example.com/oura/callback
